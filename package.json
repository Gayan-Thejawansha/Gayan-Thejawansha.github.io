{
  "name": "gayan-thejawansha-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Static portfolio and ATS-friendly CV for GitHub Pages.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "check:budget": "node scripts/performance-budget.mjs",
    "validate:html": "html-validate index.html cv.html 404.html",
    "validate:links": "linkinator dist --recurse --check-fragments --check-css --skip 'https://.*' --skip 'mailto:.*' --skip 'tel:.*' --verbosity error",
    "test": "npm run build && npm run check && npm run check:budget && npm run validate:html && npm run validate:links"
  },
  "engines": {
    "node": ">=22.19"
  },
  "devDependencies": {
    "@iconify-json/logos": "^1.2.11",
    "html-validate": "10.9.0",
    "linkinator": "8.0.2"
  }
}
